<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_square" model="payment.provider">
        <field name="name">Square</field>
        <field name="code">square</field>
        <field name="state">disabled</field>
        <field name="is_published">False</field>
        <field name="allow_tokenization">False</field>
        <field name="capture_manually">False</field>
    </record>

    <record id="payment_method_square_card" model="payment.method">
        <field name="name">Card</field>
        <field name="code">card</field>
        <field name="provider_ids" eval="[(4, ref('payment_provider_square'))]"/>
    </record>

</odoo>
