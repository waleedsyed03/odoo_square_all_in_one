<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_square" model="ir.ui.view">
        <field name="name">payment.provider.form.square</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'square'" string="Square Hosted Checkout">
                    <div class="alert alert-info" role="alert" colspan="2">
                        Customers are redirected to Square's secure hosted checkout page
                        (<code>checkout.square.site</code>), then returned to your Odoo shop
                        after payment — same flow as the WordPress Payments Connect Square plugin.
                    </div>
                    <field name="square_config_id"
                           required="code == 'square'"
                           options="{'no_create': True}"/>
                    <field name="square_location_id"
                           required="code == 'square'"
                           options="{'no_create': True}"/>
                </group>
            </group>
        </field>
    </record>

    <template id="square_redirect_form">
        <form t-att-action="api_url" method="get" id="o_square_redirect_form">
            <input type="submit" value="Redirecting to Square Checkout..." style="display:none;"/>
        </form>
        <script type="text/javascript">
            document.getElementById('o_square_redirect_form').submit();
        </script>
    </template>

    <record id="action_square_payment_provider" model="ir.actions.act_window">
        <field name="name">Square Hosted Checkout</field>
        <field name="res_model">payment.provider</field>
        <field name="view_mode">form,list</field>
        <field name="domain">[('code', '=', 'square')]</field>
        <field name="context">{'search_default_code': 'square'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect Square first, then click <strong>Enable Hosted Checkout</strong>
                on the Square configuration form.
            </p>
        </field>
    </record>

</odoo>
