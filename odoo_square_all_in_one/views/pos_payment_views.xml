<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_view_form_square" model="ir.ui.view">
        <field name="name">pos.payment.method.form.square</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="use_payment_terminal" position="after">
                <field name="square_location_id"
                       invisible="use_payment_terminal != 'square'"
                       required="use_payment_terminal == 'square'"/>
                <field name="square_device_id"
                       invisible="use_payment_terminal != 'square'"
                       required="use_payment_terminal == 'square'"/>
            </field>
        </field>
    </record>

</odoo>
