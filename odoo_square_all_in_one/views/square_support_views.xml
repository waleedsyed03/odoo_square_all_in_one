<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="square_support_request_view_form" model="ir.ui.view">
        <field name="name">square.support.request.form</field>
        <field name="model">square.support.request</field>
        <field name="arch" type="xml">
            <form string="Support">
                <sheet>
                    <div class="oe_title">
                        <h1>Support</h1>
                    </div>
                    <p class="text-muted mb-3">
                        Need help with Square Sync &amp; Pay? Our technical support team is available 24/7 on WhatsApp.
                        Fill in the form below, then click <strong>Open WhatsApp</strong> — your message will be
                        pre-filled with site details.
                    </p>
                    <group>
                        <group>
                            <field name="name" placeholder="Your name"/>
                            <field name="email" placeholder="you@company.com"/>
                            <field name="issue_type"/>
                        </group>
                        <group>
                            <field name="subject" placeholder="Short summary (optional)"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" nolabel="1" placeholder="What happened? What did you expect? Steps to reproduce…"/>
                    </group>
                    <p class="text-muted">
                        Odoo URL, module version, and Square connection status are attached automatically in WhatsApp.
                    </p>
                    <div class="mt-3">
                        <button name="action_open_whatsapp"
                                type="object"
                                string="Open WhatsApp"
                                class="btn btn-primary"
                                icon="fa-whatsapp"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_square_support" model="ir.actions.act_window">
        <field name="name">Support</field>
        <field name="res_model">square.support.request</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
