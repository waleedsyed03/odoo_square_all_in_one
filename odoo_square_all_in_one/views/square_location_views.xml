<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="square_location_view_form" model="ir.ui.view">
        <field name="name">square.location.form</field>
        <field name="model">square.location</field>
        <field name="arch" type="xml">
            <form string="Square Location">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Square">
                            <field name="config_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="square_location_id"/>
                            <field name="square_environment"/>
                            <field name="status"/>
                            <field name="active"/>
                        </group>
                        <group string="Address">
                            <field name="address_line_1"/>
                            <field name="locality"/>
                            <field name="country_code"/>
                        </group>
                    </group>
                    <group string="Odoo Mapping">
                        <group>
                            <field name="warehouse_id"/>
                            <field name="stock_location_id"/>
                        </group>
                        <group>
                            <field name="pos_config_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="square_location_view_list" model="ir.ui.view">
        <field name="name">square.location.list</field>
        <field name="model">square.location</field>
        <field name="arch" type="xml">
            <list string="Square Locations">
                <field name="name"/>
                <field name="square_location_id"/>
                <field name="square_environment"/>
                <field name="config_id"/>
                <field name="warehouse_id"/>
                <field name="stock_location_id"/>
                <field name="status"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="square_location_view_search" model="ir.ui.view">
        <field name="name">square.location.search</field>
        <field name="model">square.location</field>
        <field name="arch" type="xml">
            <search string="Square Locations">
                <field name="name"/>
                <field name="square_location_id"/>
                <field name="config_id"/>
                <field name="warehouse_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_config" string="Configuration" context="{'group_by': 'config_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_square_location" model="ir.actions.act_window">
        <field name="name">Square Locations</field>
        <field name="res_model">square.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
