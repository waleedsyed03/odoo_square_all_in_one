<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_square_inventory_sync" model="ir.cron">
        <field name="name">Square: Sync Inventory to Square</field>
        <field name="model_id" ref="model_square_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_inventory_to_square()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_square_product_sync" model="ir.cron">
        <field name="name">Square: Sync Products to Catalog</field>
        <field name="model_id" ref="model_square_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_products_to_square()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_square_inventory_import" model="ir.cron">
        <field name="name">Square: Import Inventory from Square</field>
        <field name="model_id" ref="model_square_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_inventory_from_square()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_square_oauth_refresh" model="ir.cron">
        <field name="name">Square: Refresh OAuth Tokens</field>
        <field name="model_id" ref="model_square_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_oauth_tokens()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
